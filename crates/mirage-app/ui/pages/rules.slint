import { Button, CheckBox, ComboBox, ListView, TextEdit } from "std-widgets.slint";
import { Theme } from "../components/theme.slint";
import { Card } from "../components/card.slint";
import { HelpIcon } from "../components/help-icon.slint";
import { IconButton } from "../components/icon-button.slint";

export struct RuleRow {
    raw: string,
    kind: string,
    // Position in the visual type list; -1 = advanced rule (YAML only).
    kind-index: int,
    payload: string,
    target: string,
    no-resolve: bool,
}

// Extra rules tab (iteration 2 §3). The working list lives in Rust on the
// UI thread; edits reach the core only on "保存".
component RulesTab inherits VerticalLayout {
    in property <[RuleRow]> rows;
    in property <int> count;
    in property <[string]> errors;
    in property <[string]> notes;
    in property <bool> saving;
    in property <bool> rule-mode;
    in-out property <bool> enabled;
    in-out property <bool> yaml-mode;
    in-out property <string> yaml;
    in-out property <string> mode-error;
    callback add-rule();
    callback edit-rule(int);
    callback move-rule(int, int);
    callback delete-rule(int);
    callback to-yaml() -> string;
    callback from-yaml(string) -> string;
    callback reset();
    callback save(bool, bool, string);

    min-height: 0px;
    spacing: 12px;

    HorizontalLayout {
        spacing: 8px;
        vertical-stretch: 0;
        HorizontalLayout {
            spacing: 8px;
            alignment: start;
            horizontal-stretch: 1;
            CheckBox { text: "启用附加规则"; checked <=> root.enabled; horizontal-stretch: 0; }
            HelpIcon {
                text: "附加规则插在订阅规则之前，优先命中；全局一份，对所有配置生效。\n目标“代理”走当前运行配置的主策略组（节点页第一个分组），切换配置后自动跟随。\nYAML 中写的其他策略名、规则集或子规则在当前配置中不存在时跳过该条并提示，不影响其他规则。\n不允许 MATCH。保存前用当前配置做一次内核校验；已连接时保存后热重载。";
            }
            Text {
                text: "已保存 " + root.count + " 条";
                color: Theme.text-muted;
                font-size: 12px;
                vertical-alignment: center;
            }
            if !root.yaml-mode: Button {
                text: "添加规则";
                icon: @image-url("../../assets/icons/lucide/plus.svg");
                colorize-icon: true;
                clicked => { root.add-rule(); }
            }
        }
        // Pinned to the right edge of the row.
        ComboBox {
            model: ["可视化", "YAML"];
            current-index: root.yaml-mode ? 1 : 0;
            width: 88px;
            horizontal-stretch: 0;
            accessible-label: "编辑方式";
            selected => {
                if self.current-index == 1 && !root.yaml-mode {
                    root.yaml = root.to-yaml();
                    root.mode-error = "";
                    root.yaml-mode = true;
                } else if self.current-index == 0 && root.yaml-mode {
                    root.mode-error = root.from-yaml(root.yaml);
                    if root.mode-error == "" {
                        root.yaml-mode = false;
                    }
                }
                // YAML that fails to parse stays in YAML mode.
                self.current-index = root.yaml-mode ? 1 : 0;
            }
        }
    }
    if !root.rule-mode: Text {
        text: "当前不是“规则”路由模式，附加规则暂不生效。";
        color: Theme.warn;
        font-size: 12px;
        wrap: word-wrap;
        vertical-stretch: 0;
    }
    for note in root.notes: Text {
        text: note;
        color: Theme.warn;
        font-size: 12px;
        wrap: word-wrap;
        vertical-stretch: 0;
    }

    if !root.yaml-mode: VerticalLayout {
        vertical-stretch: 1;
        min-height: 0px;
        spacing: 8px;
        if root.rows.length == 0: Text {
            text: "还没有附加规则，点击上方“添加规则”。";
            color: Theme.text-muted;
            horizontal-alignment: center;
            vertical-alignment: center;
            vertical-stretch: 1;
        }
        if root.rows.length > 0: ListView {
            vertical-stretch: 1;
            min-height: 120px;
            for row[i] in root.rows: Rectangle {
                height: 40px;
                HorizontalLayout {
                    x: 8px;
                    width: parent.width - 16px;
                    spacing: 8px;
                    Text { text: i + 1; width: 32px; color: Theme.text-muted; vertical-alignment: center; }
                    Text {
                        text: row.kind-index < 0 ? row.kind + "（高级）" : row.kind;
                        width: 150px;
                        color: Theme.text;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: row.payload + (row.no-resolve ? "  · no-resolve" : "");
                        color: Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                        min-width: 0px;
                    }
                    Text {
                        text: "→ " + (row.target == "PROXY" ? "代理" : row.target == "DIRECT" ? "直连" : row.target == "REJECT" ? "拒绝" : row.target);
                        color: Theme.text-muted;
                        vertical-alignment: center;
                        overflow: elide;
                        width: 140px;
                    }
                    IconButton {
                        y: 6px;
                        icon: @image-url("../../assets/icons/lucide/arrow-up.svg");
                        label: "上移";
                        enabled: i > 0;
                        clicked => { root.move-rule(i, -1); }
                    }
                    IconButton {
                        y: 6px;
                        icon: @image-url("../../assets/icons/lucide/arrow-down.svg");
                        label: "下移";
                        enabled: i < root.rows.length - 1;
                        clicked => { root.move-rule(i, 1); }
                    }
                    IconButton {
                        y: 6px;
                        icon: @image-url("../../assets/icons/lucide/pencil.svg");
                        label: "编辑";
                        enabled: row.kind-index >= 0;
                        clicked => { root.edit-rule(i); }
                    }
                    IconButton {
                        y: 6px;
                        icon: @image-url("../../assets/icons/lucide/trash-2.svg");
                        label: "删除";
                        clicked => { root.delete-rule(i); }
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.border;
                }
            }
        }
    }
    if root.yaml-mode: VerticalLayout {
        vertical-stretch: 1;
        min-height: 0px;
        spacing: 8px;
        Text {
            text: "格式与 Mihomo 相同：rules: 下每行一条，目标写 PROXY 表示代理（当前配置的主策略组）。逻辑规则、RULE-SET、SUB-RULE 等只能在这里编辑。可视化模式下改动后会重新生成 YAML，注释不保留。";
            color: Theme.text-muted;
            font-size: 12px;
            wrap: word-wrap;
            vertical-stretch: 0;
        }
        TextEdit {
            text <=> root.yaml;
            vertical-stretch: 1;
            min-height: 160px;
            wrap: no-wrap;
            font-size: 15px;
            placeholder-text: "rules:\n  - DOMAIN-SUFFIX,example.com,PROXY\n  - DOMAIN-SUFFIX,example.cn,DIRECT\n  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve\n  - AND,((DOMAIN-SUFFIX,example.org),(NETWORK,udp)),REJECT";
            accessible-label: "附加规则 YAML";
        }
    }
    if root.mode-error != "": Text {
        text: root.mode-error;
        color: Theme.danger;
        font-size: 12px;
        wrap: word-wrap;
        vertical-stretch: 0;
    }
    if root.errors.length > 0: Card {
        vertical-stretch: 0;
        VerticalLayout {
            spacing: 4px;
            for line in root.errors: Text {
                text: line;
                color: Theme.danger;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        vertical-stretch: 0;
        Button {
            text: root.saving ? "正在校验…" : "保存";
            primary: true;
            enabled: !root.saving;
            icon: @image-url("../../assets/icons/lucide/check.svg");
            colorize-icon: true;
            clicked => { root.save(root.enabled, root.yaml-mode, root.yaml); }
        }
        Button {
            text: "放弃修改";
            enabled: !root.saving;
            clicked => { root.reset(); }
        }
    }
}

// Hosts tab (iteration 2 §2). Edits stay local until "保存"; the core
// validates them, checks the active config with `mihomo -t`, then saves.
component HostsTab inherits VerticalLayout {
    in property <bool> saved-enabled;
    in property <string> saved-text;
    in property <int> count;
    in property <[string]> errors;
    in property <bool> saving;
    callback save(bool, string);

    property <bool> enabled: root.saved-enabled;
    property <string> text: root.saved-text;

    min-height: 0px;
    spacing: 12px;

    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        vertical-stretch: 0;
        CheckBox { text: "启用 Hosts"; checked <=> root.enabled; horizontal-stretch: 0; }
        HelpIcon {
            text: "只写入 Mirage 内核的运行配置，不修改系统 hosts 文件，只对经过 Mirage 的流量生效。\n对直连连接和 TUN 下的 DNS 解析生效；经代理节点转发的连接通常由节点解析域名，可能不生效（待核验）。\n保存前会用当前配置做一次内核校验；已连接时保存后热重载。";
        }
        Text {
            text: "已保存 " + root.count + " 个域名";
            color: Theme.text-muted;
            font-size: 12px;
            vertical-alignment: center;
        }
    }
    Text {
        text: "每行一个 IP，后接一个或多个域名，空格分隔；# 开头为注释。支持 *.example.com（一级子域）和 +.example.com（本身及所有子域）。";
        color: Theme.text-muted;
        font-size: 12px;
        wrap: word-wrap;
        vertical-stretch: 0;
    }
    TextEdit {
        text <=> root.text;
        vertical-stretch: 1;
        min-height: 160px;
        wrap: no-wrap;
        font-size: 15px;
        placeholder-text: "# 示例\n192.168.1.10   nas.local\n10.0.0.1       *.dev.example.com   api.example.com\n::1            v6.local";
        accessible-label: "Hosts";
    }
    if root.errors.length > 0: Card {
        vertical-stretch: 0;
        VerticalLayout {
            spacing: 4px;
            for line in root.errors: Text {
                text: line;
                color: Theme.danger;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        vertical-stretch: 0;
        Button {
            text: root.saving ? "正在校验…" : "保存";
            primary: true;
            enabled: !root.saving;
            icon: @image-url("../../assets/icons/lucide/check.svg");
            colorize-icon: true;
            clicked => { root.save(root.enabled, root.text); }
        }
        Button {
            text: "放弃修改";
            enabled: !root.saving;
            clicked => {
                root.enabled = root.saved-enabled;
                root.text = root.saved-text;
            }
        }
    }
}

// Rules page (iteration 2 §0): extra rules and hosts, one global set each.
export component RulesPage inherits VerticalLayout {
    in-out property <int> tab;
    in property <[RuleRow]> rule-rows;
    in property <int> rules-count;
    in property <[string]> rules-errors;
    in property <[string]> rules-notes;
    in property <bool> rules-saving;
    in property <bool> rule-mode;
    in-out property <bool> rules-enabled;
    in-out property <bool> rules-yaml-mode;
    in-out property <string> rules-yaml;
    in-out property <string> rules-mode-error;
    callback add-rule();
    callback edit-rule(int);
    callback move-rule(int, int);
    callback delete-rule(int);
    callback rules-to-yaml() -> string;
    callback rules-from-yaml(string) -> string;
    callback rules-reset();
    callback save-rules(bool, bool, string);
    in property <bool> hosts-enabled;
    in property <string> hosts-text;
    in property <int> hosts-count;
    in property <[string]> hosts-errors;
    in property <bool> hosts-saving;
    callback save-hosts(bool, string);

    min-width: 0px;
    min-height: 0px;
    spacing: 12px;

    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        vertical-stretch: 0;
        Button { text: "附加规则"; primary: root.tab == 0; clicked => { root.tab = 0; } }
        Button { text: "追加 Hosts"; primary: root.tab == 1; clicked => { root.tab = 1; } }
    }
    if root.tab == 0: RulesTab {
        vertical-stretch: 1;
        rows: root.rule-rows;
        count: root.rules-count;
        errors: root.rules-errors;
        notes: root.rules-notes;
        saving: root.rules-saving;
        rule-mode: root.rule-mode;
        enabled <=> root.rules-enabled;
        yaml-mode <=> root.rules-yaml-mode;
        yaml <=> root.rules-yaml;
        mode-error <=> root.rules-mode-error;
        add-rule => { root.add-rule(); }
        edit-rule(i) => { root.edit-rule(i); }
        move-rule(i, d) => { root.move-rule(i, d); }
        delete-rule(i) => { root.delete-rule(i); }
        to-yaml => { return root.rules-to-yaml(); }
        from-yaml(text) => { return root.rules-from-yaml(text); }
        reset => { root.rules-reset(); }
        save(enabled, yaml-mode, text) => { root.save-rules(enabled, yaml-mode, text); }
    }
    if root.tab == 1: HostsTab {
        vertical-stretch: 1;
        saved-enabled: root.hosts-enabled;
        saved-text: root.hosts-text;
        count: root.hosts-count;
        errors: root.hosts-errors;
        saving: root.hosts-saving;
        save(enabled, text) => { root.save-hosts(enabled, text); }
    }
}
