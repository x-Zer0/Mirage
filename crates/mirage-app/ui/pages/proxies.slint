import { Button, CheckBox, ListView, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "../components/theme.slint";

export struct NodeRow {
    name: string,
    delay: string,
    delay-level: int, // 0 unknown, 1 good, 2 slow, 3 failed
    current: bool,
}

export struct GroupRow {
    name: string,
    kind: string,
    now: string,
    selectable: bool,
    nodes: [NodeRow],
    // Nodes not listed: beyond the 1000-row cap or not matching the search.
    hidden: int,
}

export component ProxiesPage inherits VerticalLayout {
    in property <[GroupRow]> groups;
    in property <bool> running;
    in property <string> testing-group;
    in-out property <int> current-group: 0;
    in-out property <string> filter;
    in-out property <bool> sort-by-delay;
    callback select-node(string, string);
    callback sort-changed(bool);
    callback test-delay(string);
    callback refresh();
    callback filter-changed(string);

    // The tab list changes with the routing mode (GLOBAL); stay in range.
    property <int> shown-group: min(root.current-group, max(0, root.groups.length - 1));

    min-width: 0px;
    spacing: 12px;

    if !root.running: Text {
        text: "连接后显示代理组和节点。";
        color: Theme.text-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
        horizontal-stretch: 1;
        vertical-stretch: 1;
    }

    if root.running && root.groups.length > 0: HorizontalLayout {
        spacing: 8px;
        ScrollView {
            height: 48px;
            min-width: 0px;
            horizontal-stretch: 1;
            vertical-scrollbar-policy: always-off;
            content-width: tabs.preferred-width;
            content-height: 32px;
            tabs := HorizontalLayout {
                spacing: 6px;
                for g[i] in root.groups: Rectangle {
                    width: label.preferred-width + 24px;
                    height: 32px;
                    border-radius: 6px;
                    background: i == root.shown-group ? Theme.nav-selected : tab.has-hover ? Theme.nav-hover : Theme.sidebar;
                    accessible-role: AccessibleRole.tab;
                    accessible-label: g.name;
                    accessible-item-selected: i == root.shown-group;
                    tab := TouchArea { clicked => { root.current-group = i; } }
                    label := Text {
                        text: g.name;
                        color: i == root.shown-group ? Theme.accent : Theme.text;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }
        }
        Button {
            text: "刷新";
            icon: @image-url("../../assets/icons/lucide/refresh-cw.svg");
            colorize-icon: true;
            clicked => { root.refresh(); }
        }
    }

    if root.running && root.groups.length > 0: VerticalLayout {
        spacing: 8px;
        vertical-stretch: 1;
        property <GroupRow> group: root.groups[root.shown-group];

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: group.kind + " · 当前：" + group.now + (group.selectable ? "" : "（自动选择，只读）");
                color: Theme.text-muted;
                vertical-alignment: center;
                horizontal-stretch: 1;
                min-width: 0px;
                wrap: word-wrap;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            CheckBox {
                text: "按延迟排序";
                checked <=> root.sort-by-delay;
                toggled => { root.sort-changed(self.checked); }
            }
            LineEdit {
                placeholder-text: "搜索节点";
                min-width: 80px;
                preferred-width: 180px;
                horizontal-stretch: 1;
                text <=> root.filter;
                edited(text) => { root.filter-changed(text); }
            }
            Button {
                text: root.testing-group == group.name ? "测速中…" : "测速";
                icon: @image-url("../../assets/icons/lucide/activity.svg");
                colorize-icon: true;
                enabled: root.testing-group == "";
                clicked => { root.test-delay(group.name); }
            }
        }

        ListView {
            min-width: 0px;
            min-height: 180px;
            preferred-height: 0px;
            vertical-stretch: 1;
            for n in group.nodes: Rectangle {
                height: 40px;
                border-radius: 6px;
                background: n.current ? Theme.nav-selected : row.has-hover && group.selectable ? Theme.nav-hover : transparent;
                accessible-role: list-item;
                accessible-label: n.name;
                accessible-item-selected: n.current;
                accessible-action-default => { if (group.selectable) { root.select-node(group.name, n.name); } }
                row := TouchArea {
                    enabled: group.selectable;
                    mouse-cursor: group.selectable ? pointer : default;
                    clicked => { root.select-node(group.name, n.name); }
                }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    Text {
                        text: n.name;
                        color: n.current ? Theme.accent : Theme.text;
                        vertical-alignment: center;
                        min-width: 0px;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: n.delay;
                        vertical-alignment: center;
                        color: n.delay-level == 1 ? Theme.ok : n.delay-level == 2 ? Theme.warn : n.delay-level == 3 ? Theme.danger : Theme.text-muted;
                    }
                }
            }
        }

        if group.hidden > 0: Text {
            text: "另有 " + group.hidden + " 个节点未列出" + (root.filter == "" ? "（列表最多显示 1000 个，可用搜索查找）" : "（不匹配搜索或超出 1000 个）");
            color: Theme.text-muted;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}
