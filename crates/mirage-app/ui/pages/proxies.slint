import { Button, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "../components/theme.slint";
import { NodeCard } from "../components/node-card.slint";
import { CurrentNodeLink } from "../components/current-node-link.slint";
import { ToggleButton } from "../components/toggle-button.slint";

export struct NodeRow {
    name: string,
    display-name: string,
    flag-index: int,
    details: string,
    delay: string,
    delay-level: int, // 0 unknown/pending, 1 good, 2 slow, 3 failed
    delay-detail: string,
    current: bool,
}

export struct GroupRow {
    name: string,
    kind: string,
    now: string,
    current-label: string,
    current-flag-index: int,
    current-node-index: int,
    selectable: bool,
    nodes: [NodeRow],
    // Nodes not listed: beyond the 1000-row cap or not matching the search.
    hidden: int,
}

export component ProxiesPage inherits VerticalLayout {
    in property <[GroupRow]> groups;
    in property <bool> running;
    in property <string> testing-group;
    in property <int> testing-completed;
    in property <int> testing-total;
    in-out property <int> current-group: 0;
    in-out property <string> filter;
    in-out property <bool> sort-by-delay;
    callback select-node(string, string);
    callback sort-changed(bool);
    callback test-delay(string);
    callback filter-changed(string);

    // The tab list changes with the routing mode (GLOBAL); stay in range.
    property <int> shown-group: min(root.current-group, max(0, root.groups.length - 1));

    min-width: 0px;
    spacing: 8px;

    if !root.running: Text {
        text: "连接后显示代理组和节点。";
        color: Theme.text-muted;
        horizontal-alignment: center;
        vertical-alignment: center;
        horizontal-stretch: 1;
        vertical-stretch: 1;
    }

    if root.running && root.groups.length > 0: HorizontalLayout {
        spacing: 8px;
        ScrollView {
            height: 32px;
            min-width: 0px;
            horizontal-stretch: 1;
            vertical-scrollbar-policy: always-off;
            content-width: tabs.preferred-width;
            content-height: 32px;
            tabs := HorizontalLayout {
                spacing: 6px;
                for g[i] in root.groups: Rectangle {
                    width: label.preferred-width + 24px;
                    height: 32px;
                    border-radius: 6px;
                    background: i == root.shown-group ? Theme.nav-selected : tab.has-hover ? Theme.nav-hover : Theme.sidebar;
                    accessible-role: AccessibleRole.tab;
                    accessible-label: g.name;
                    accessible-item-selected: i == root.shown-group;
                    tab := TouchArea { clicked => { root.current-group = i; } }
                    label := Text {
                        text: g.name;
                        color: i == root.shown-group ? Theme.accent : Theme.text;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }
        }
    }

    if root.running && root.groups.length > 0: VerticalLayout {
        spacing: 8px;
        vertical-stretch: 1;
        property <GroupRow> group: root.groups[root.shown-group];

        Rectangle {
            height: 32px;
            CurrentNodeLink {
                x: 0px;
                y: 0px;
                width: min((parent.width - 12px) / 2, self.preferred-width);
                height: parent.height;
                text: group.kind + " · " + group.now + (group.selectable ? "" : "（自动选择，只读）");
                prefix: group.kind + " ·";
                display-name: group.current-label + (group.selectable ? "" : "（自动选择，只读）");
                flag-index: group.current-flag-index;
                enabled: group.now != "";
                clicked => {
                    if group.current-node-index < 0 && root.filter != "" {
                        root.filter = "";
                        root.filter-changed("");
                    }
                    locate-timer.running = false;
                    locate-timer.running = true;
                }
            }
            HorizontalLayout {
                x: (parent.width + 12px) / 2;
                width: (parent.width - 12px) / 2;
                height: parent.height;
                spacing: 8px;
                LineEdit {
                    placeholder-text: "搜索节点";
                    min-width: 0px;
                    preferred-width: 0px;
                    horizontal-stretch: 1;
                    text <=> root.filter;
                    edited(text) => { root.filter-changed(text); }
                }
                ToggleButton {
                    text: "延迟排序";
                    checked <=> root.sort-by-delay;
                    enabled: root.testing-group == "";
                    toggled(on) => { root.sort-changed(on); }
                }
                Button {
                    width: 80px;
                    text: root.testing-group == group.name ? root.testing-completed + "/" + root.testing-total : "测速";
                    icon: root.testing-group == group.name ? @image-url("") : @image-url("../../assets/icons/lucide/activity.svg");
                    colorize-icon: true;
                    enabled: root.testing-group == "" && group.nodes.length + group.hidden > 0;
                    clicked => { root.test-delay(group.name); }
                }
            }
        }

        node-list := ScrollView {
            min-width: 0px;
            min-height: 180px;
            preferred-height: 0px;
            vertical-stretch: 1;
            horizontal-scrollbar-policy: always-off;
            content-width: self.visible-width;
            // Reserve the scrollbar gutter so cards remain fully clickable.
            property <length> grid-width: max(0px, self.visible-width - 16px);
            property <length> gap: 8px;
            property <length> card-height: 68px;
            property <length> row-height: self.card-height + self.gap;
            property <int> columns: max(1, floor((self.grid-width + self.gap) / (240px + self.gap)));
            property <length> card-width: max(0px, (self.grid-width - (self.columns - 1) * self.gap) / self.columns);
            property <int> row-count: ceil(group.nodes.length / self.columns);
            content-height: self.row-count * self.row-height;
            accessible-role: list;
            property <int> first-row: max(0, min(self.row-count - 1,
                floor(-self.content-y / self.row-height) - 1));
            property <int> rendered-row-count: max(0, min(self.row-count - self.first-row,
                ceil(self.visible-height / self.row-height) + 3));

            // Render visible rows with overscan, preserving the exact scroll offset.
            for offset in node-list.rendered-row-count: Rectangle {
                property <int> row-index: node-list.first-row + offset;
                y: self.row-index * node-list.row-height;
                width: node-list.grid-width;
                height: node-list.row-height;
                for column in node-list.columns: Rectangle {
                    x: column * (node-list.card-width + node-list.gap);
                    width: node-list.card-width;
                    height: node-list.card-height;
                    if row-index * node-list.columns + column < group.nodes.length: NodeCard {
                        property <NodeRow> node: group.nodes[row-index * node-list.columns + column];
                        width: parent.width;
                        name: node.name;
                        display-name: node.display-name;
                        flag-index: node.flag-index;
                        details: node.details;
                        delay: node.delay;
                        delay-level: node.delay-level;
                        delay-detail: node.delay-detail;
                        current: node.current;
                        selectable: group.selectable;
                        selected => { root.select-node(group.name, node.name); }
                    }
                }
            }
        }

        // Wait until clearing the search has updated the virtualized row model.
        locate-timer := Timer {
            interval: 0ms;
            running: false;
            triggered => {
                self.running = false;
                if group.current-node-index >= 0 {
                    node-list.content-y = -min(
                        max(0px, node-list.row-count * node-list.row-height - node-list.visible-height),
                        floor(group.current-node-index / node-list.columns) * node-list.row-height
                    );
                }
            }
        }

        if group.hidden > 0: Text {
            text: "另有 " + group.hidden + " 个节点未列出" + (root.filter == "" ? "（列表最多显示 1000 个，可用搜索查找）" : "（不匹配搜索或超出 1000 个）");
            color: Theme.text-muted;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}
