import { Button, Switch } from "std-widgets.slint";
import { Theme } from "../components/theme.slint";
import { Card } from "../components/card.slint";

export component OverviewPage inherits VerticalLayout {
    in property <string> status-text;
    in property <bool> running;
    in property <bool> busy;
    in property <bool> failed;
    in property <string> profile-name;
    in property <int> mixed-port;
    in property <string> core-version;
    // in-out: the Switch writes it on toggle; a one-way binding would break.
    in-out property <bool> system-proxy-wanted;
    in property <bool> system-proxy-active;
    in-out property <bool> tun-wanted;
    in property <bool> tun-active;
    in property <bool> service-installed;
    callback set-tun(bool);
    in property <string> connectivity-text;
    in property <int> connectivity-level; // 0 unknown/checking, 1 ok, 2 failed
    in property <int> routing-mode; // -1 unknown, 0 rule, 1 global, 2 direct
    in property <string> exit-node;
    in property <string> up-rate;
    in property <string> down-rate;
    // SVG path commands over a 60 x 100 viewbox (one point per second).
    in property <string> up-path;
    in property <string> down-path;
    in property <string> plan;
    in property <string> usage;
    callback connect();
    callback disconnect();
    callback set-system-proxy(bool);
    callback check-connectivity();
    callback set-routing-mode(int);

    min-width: 0px;
    spacing: 16px;
    alignment: start;

    Card {
        HorizontalLayout {
            min-width: 0px;
            spacing: 16px;
            Image {
                source: root.running ? @image-url("../../assets/icons/tray/connected.svg")
                : root.failed ? @image-url("../../assets/icons/tray/error.svg")
                : @image-url("../../assets/icons/tray/idle.svg");
                width: 48px;
                height: 48px;
                y: (parent.height - self.height) / 2;
            }
            VerticalLayout {
                alignment: center;
                spacing: 4px;
                horizontal-stretch: 1;
                Text {
                    text: root.status-text;
                    font-size: 18px;
                    font-weight: 600;
                    color: root.failed ? Theme.danger : Theme.text;
                    // Details belong in the error bar; keep the header one line.
                    overflow: elide; min-width: 0px;
                }
                Text { text: root.profile-name == "" ? "未选择配置" : "当前配置：" + root.profile-name; color: Theme.text-muted; wrap: word-wrap; min-width: 0px; }
                if root.running && root.exit-node != "": Text { text: "出口节点：" + root.exit-node; color: Theme.text-muted; overflow: elide; min-width: 0px; }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: root.busy ? "请稍候…" : root.running ? "断开" : "连接";
                    primary: !root.running && !root.busy;
                    enabled: !root.busy;
                    opacity: root.busy ? 0.45 : 1;
                    icon: @image-url("../../assets/icons/lucide/power.svg");
                    colorize-icon: true;
                    clicked => { root.running ? root.disconnect() : root.connect(); }
                }
            }
        }
    }

    GridLayout {
        spacing: 16px;
        Card {
            row: 0;
            col: 0;
            horizontal-stretch: 1;
            VerticalLayout {
                spacing: 10px;
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text { text: "系统代理"; color: Theme.text; font-weight: 600; }
                        Text {
                            text: root.system-proxy-active ? "已指向 127.0.0.1:" + root.mixed-port
                            : root.system-proxy-wanted ? "连接后自动开启"
                            : "未开启";
                            color: Theme.text-muted;
                        }
                    }
                    Switch {
                        checked <=> root.system-proxy-wanted;
                        accessible-label: "系统代理";
                        toggled => { root.set-system-proxy(self.checked); }
                    }
                }
                HorizontalLayout {
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text { text: "TUN 模式"; color: Theme.text; font-weight: 600; }
                        Text { text: root.tun-active ? "已开启" : root.tun-wanted ? "连接后开启" : root.service-installed ? "未开启" : "首次开启需要安装辅助服务"; color: Theme.text-muted; wrap: word-wrap; min-width: 0px; }
                    }
                    Switch {
                        checked <=> root.tun-wanted;
                        enabled: !root.busy;
                        accessible-label: "TUN 模式";
                        toggled => { root.set-tun(self.checked); }
                    }
                }
                Text {
                    text: "系统代理只对读取 Windows 代理设置的程序生效（如浏览器），并非接管全部流量。";
                    color: Theme.text-muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }

        Card {
            row: root.width < 700px ? 1 : 0;
            col: root.width < 700px ? 0 : 1;
            horizontal-stretch: 1;
            VerticalLayout {
                spacing: 10px;
                Text { text: "路由模式"; color: Theme.text; font-weight: 600; }
                HorizontalLayout {
                    spacing: 6px;
                    for label[i] in ["规则", "全局", "直连"]: Rectangle {
                        height: 32px;
                        horizontal-stretch: 1;
                        border-radius: 6px;
                        background: i == root.routing-mode ? Theme.nav-selected : mode-touch.has-hover ? Theme.nav-hover : Theme.sidebar;
                        accessible-role: AccessibleRole.button;
                        accessible-label: "路由模式：" + label;
                        accessible-checkable: true;
                        accessible-checked: i == root.routing-mode;
                        accessible-action-default => { root.set-routing-mode(i); }
                        mode-touch := TouchArea { clicked => { root.set-routing-mode(i); } }
                        Text {
                            text: label;
                            color: i == root.routing-mode ? Theme.accent : Theme.text;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                Text {
                    text: root.routing-mode < 0 ? "使用配置中的模式" : "规则：按订阅规则分流；全局：全部经所选节点；直连：不经代理。";
                    color: Theme.text-muted;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }
    }

    Card {
        VerticalLayout {
            spacing: 8px;
            HorizontalLayout {
                min-width: 0px;
                spacing: 16px;
                Text { text: "实时速率"; color: Theme.text; font-weight: 600; horizontal-stretch: 1; vertical-alignment: center; }
                Text { text: "↑ " + root.up-rate; color: Theme.up; vertical-alignment: center; }
                Text { text: "↓ " + root.down-rate; color: Theme.down; vertical-alignment: center; }
            }
            Rectangle {
                height: 64px;
                background: Theme.sidebar;
                border-radius: 4px;
                clip: true;
                if root.running: Path {
                    width: parent.width;
                    height: parent.height;
                    viewbox-width: 60;
                    viewbox-height: 100;
                    commands: root.down-path;
                    stroke: Theme.down;
                    stroke-width: 1.5px;
                }
                if root.running: Path {
                    width: parent.width;
                    height: parent.height;
                    viewbox-width: 60;
                    viewbox-height: 100;
                    commands: root.up-path;
                    stroke: Theme.up;
                    stroke-width: 1.5px;
                }
                if !root.running: Text {
                    text: "连接后显示";
                    color: Theme.text-muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    Card {
        VerticalLayout {
            spacing: 6px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "连通性：" + root.connectivity-text;
                    color: root.connectivity-level == 1 ? Theme.ok : root.connectivity-level == 2 ? Theme.danger : Theme.text;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
                Button {
                    icon: @image-url("../../assets/icons/lucide/refresh-cw.svg");
                    colorize-icon: true;
                    accessible-label: "重新检测连通性";
                    enabled: root.running && !root.busy;
                    clicked => { root.check-connectivity(); }
                }
            }
            Text { text: "本地代理端口：127.0.0.1:" + root.mixed-port; color: Theme.text; }
            if root.plan != "": Text { text: "套餐：" + root.plan; color: Theme.text; }
            if root.usage != "": Text { text: root.usage; color: Theme.text-muted; wrap: word-wrap; min-width: 0px; }
            Text { text: "内核：" + root.core-version; color: Theme.text-muted; wrap: word-wrap; min-width: 0px; }
        }
    }
}
