import { Button, ListView, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "../components/theme.slint";
import { IconButton } from "../components/icon-button.slint";

export struct ProfileRow {
    id: string,
    name: string,
    source: string,
    account-id: string,
    detail: string,
    updated: string,
    selected: bool,
    remote: bool,
    updating: bool,
    usage: string,
    fetch-error: string,
    has-url: bool,
    interval-hours: int,
    egress: int,
    policy-notes: [string],
}

export component ProfilesPage inherits VerticalLayout {
    in property <[ProfileRow]> profiles;
    in property <bool> busy;
    in property <int> drawer-dismissed-count;
    in property <[string]> policy-notes;
    in-out property <string> new-name;
    in-out property <string> new-url;
    callback import-file();
    callback add-remote(string, string);
    callback update(string);
    callback update-all();
    callback select(string);
    callback remove(ProfileRow);
    callback show-details(string);
    callback open-accounts();

    changed drawer-dismissed-count => { url-input.clear-focus(); }

    min-width: 0px;
    spacing: 12px;

    HorizontalLayout {
        spacing: 8px;
        url-input := LineEdit {
            min-width: 80px;
            placeholder-text: "订阅链接（https://…）";
            text <=> root.new-url;
            horizontal-stretch: 3;
            accepted => {
                if (root.new-url != "" && !root.busy) {
                    root.add-remote(root.new-name, root.new-url);
                    root.new-url = "";
                    root.new-name = "";
                }
            }
        }
        LineEdit {
            min-width: 80px;
            placeholder-text: "名称（可选）";
            text <=> root.new-name;
            horizontal-stretch: 1;
        }
        Button {
            text: "添加订阅";
            icon: @image-url("../../assets/icons/lucide/link.svg");
            colorize-icon: true;
            primary: true;
            enabled: !root.busy && root.new-url != "";
            clicked => {
                root.add-remote(root.new-name, root.new-url);
                // The URL is only kept by the core (SecretStore), not in the UI.
                root.new-url = "";
                root.new-name = "";
            }
        }
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        Button {
            text: "导入本地配置";
            icon: @image-url("../../assets/icons/lucide/file-plus.svg");
            colorize-icon: true;
            enabled: !root.busy;
            clicked => { root.import-file(); }
        }
        Button {
            text: "全部更新";
            icon: @image-url("../../assets/icons/lucide/refresh-cw.svg");
            colorize-icon: true;
            clicked => { root.update-all(); }
        }
        Button {
            text: "添加自由猫账号";
            icon: @image-url("../../assets/icons/lucide/circle-user.svg");
            colorize-icon: true;
            clicked => { root.open-accounts(); }
        }
    }

    if root.profiles.length == 0: Text {
        text: "还没有配置。添加一个订阅链接，或导入完整的 Mihomo YAML 配置。";
        color: Theme.text-muted;
        min-width: 0px;
        wrap: word-wrap;
    }

    ListView {
        min-width: 0px;
        min-height: 180px;
        preferred-height: 0px;
        vertical-stretch: 1;
        for p in root.profiles: Rectangle {
            height: row-layout.preferred-height;
            background: p.selected ? Theme.nav-selected : touch.has-hover ? Theme.nav-hover : transparent;
            border-radius: 6px;
            accessible-role: list-item;
            accessible-label: p.name;
            accessible-item-selected: p.selected;
            accessible-action-default => { if (!root.busy) { root.select(p.id); } }
            // No switching while a start/stop or import is in flight.
            touch := TouchArea {
                clicked => { if !root.busy { root.select(p.id); } }
                row-layout := VerticalLayout {
                    padding: 10px;
                    spacing: 8px;
                    HorizontalLayout {
                        spacing: 12px;
                        col := VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            horizontal-stretch: 1;
                            Text { text: p.name; font-weight: 600; color: p.selected ? Theme.accent : Theme.text; overflow: elide; min-width: 0px; }
                            Text { text: p.source + " · " + p.detail + " · 更新于 " + p.updated; color: Theme.text-muted; font-size: 12px; overflow: elide; min-width: 0px; }
                            if p.usage != "": Text { text: p.usage; color: Theme.text-muted; font-size: 12px; wrap: word-wrap; min-width: 0px; }
                            if !p.updating && p.fetch-error != "": Text { text: p.fetch-error; color: Theme.danger; font-size: 12px; wrap: word-wrap; }

                        }
                        if p.selected: Image {
                            source: @image-url("../../assets/icons/lucide/check.svg");
                            width: 18px; height: 18px;
                            y: (parent.height - self.height) / 2;
                            colorize: Theme.accent;
                        }
                        HorizontalLayout {
                            height: 28px;
                            y: (parent.height - self.height) / 2;
                            spacing: 2px;
                            IconButton {
                                icon: @image-url("../../assets/icons/lucide/settings.svg");
                                label: "设置 " + p.name;
                                icon-size: 20px;
                                visible: touch.has-hover;
                                clicked => { root.show-details(p.id); }
                            }
                            if p.remote: IconButton {
                                icon: @image-url("../../assets/icons/lucide/refresh-cw.svg");
                                label: "更新 " + p.name;
                                icon-size: 20px;
                                visible: touch.has-hover;
                                enabled: !p.updating;
                                clicked => { root.update(p.id); }
                            }
                            IconButton {
                                icon: @image-url("../../assets/icons/lucide/trash-2.svg");
                                label: "删除 " + p.name;
                                icon-size: 20px;
                                visible: touch.has-hover;
                                icon-color: Theme.danger;
                                enabled: !root.busy;
                                clicked => { root.remove(p); }
                            }
                        }
                    }
                }
            }
        }
    }

    if root.policy-notes.length > 0: notes-scroll := ScrollView {
        height: min(96px, notes.preferred-height);
        horizontal-scrollbar-policy: always-off;
        content-width: self.visible-width;
        content-height: notes.preferred-height;
        notes := VerticalLayout {
            width: max(0px, notes-scroll.visible-width - 16px);
            spacing: 2px;
            Text { text: "最近一次导入或更新的安全调整："; color: Theme.text-muted; font-size: 12px; wrap: word-wrap; min-width: 0px; }
            for note in root.policy-notes: Text { text: "· " + note; color: Theme.text-muted; font-size: 12px; wrap: word-wrap; min-width: 0px; }
        }
    }
}
