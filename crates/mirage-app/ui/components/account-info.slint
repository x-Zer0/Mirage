import { Button } from "std-widgets.slint";
import { IconButton } from "icon-button.slint";
import { Theme } from "../components/theme.slint";

export struct AccountRow {
    id: string,
    name: string,
    provider-name: string,
    status: string,
    status-level: int,
    busy: bool,
    plan: string,
    usage: string,
    expires: string,
}

export component AccountInfo inherits VerticalLayout {
    in property <AccountRow> account;
    in property <bool> busy;
    in property <string> revealed-name;
    callback refresh(string);
    callback reveal(string, bool);
    spacing: 8px;
    Text { text: root.account.provider-name + "账号信息"; font-weight: 600; color: Theme.text; }
    HorizontalLayout {
        spacing: 8px;
        HorizontalLayout {
            spacing: 4px;
            horizontal-stretch: 0;
            max-width: self.preferred-width;
            Text {
                text: root.revealed-name == "" ? root.account.name : root.revealed-name;
                color: Theme.text;
                wrap: word-wrap;
                vertical-alignment: center;
                min-width: 0px;
                horizontal-stretch: 0;
                max-width: self.preferred-width;
            }
            VerticalLayout {
                alignment: center;
                vertical-stretch: 1;
                IconButton {
                    icon: root.revealed-name == "" ? @image-url("../../assets/icons/lucide/eye.svg") : @image-url("../../assets/icons/lucide/eye-off.svg");
                    icon-size: 14px;
                    width: 24px;
                    height: 24px;
                    label: root.revealed-name == "" ? "显示完整账号" : "隐藏账号";
                    show-focus-border: false;
                    enabled: !root.busy;
                    clicked => { root.reveal(root.account.id, root.revealed-name == ""); }
                }
            }
        }
        Rectangle { horizontal-stretch: 1; }
        Button {
            text: root.account.busy ? "验证中…" : "刷新信息";
            icon: @image-url("../../assets/icons/lucide/refresh-cw.svg");
            colorize-icon: true;
            enabled: !root.busy && !root.account.busy;
            clicked => { root.refresh(root.account.id); }
        }
    }
    if root.account.status != "": Text {
        text: root.account.status;
        color: root.account.status-level == 2 ? Theme.danger : Theme.text-muted;
        wrap: word-wrap;
    }
    Text { text: "套餐：" + (root.account.plan == "" ? "未提供" : root.account.plan); color: Theme.text; wrap: word-wrap; }
    Text { text: root.account.usage == "" ? "流量：未提供" : root.account.usage; color: Theme.text-muted; wrap: word-wrap; }
    Text { text: root.account.expires; color: Theme.text-muted; wrap: word-wrap; }
}
