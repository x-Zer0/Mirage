// Main window, navigation shell and system tray (DESIGN.md §17).
import { PageScroll, PageViewport } from "components/page-scroll.slint";
import { Theme } from "components/theme.slint";
import { Sidebar } from "components/sidebar.slint";
import { ErrorBar, Toast } from "components/error-bar.slint";
import { OverviewPage } from "pages/overview.slint";
import { ProfilesPage, ProfileRow } from "pages/profiles.slint";
import { ProxiesPage, GroupRow, NodeRow } from "pages/proxies.slint";
import { AccountRow } from "components/account-info.slint";
import { AccountDialog } from "providers/ziyoumao.slint";
import { ProfileDetails } from "pages/profile-details.slint";
import { Overlay } from "components/overlay.slint";
import { Button } from "std-widgets.slint";
import { SettingsPage } from "pages/settings.slint";
import { LogsPage, ConnectionRow, OperationRow } from "pages/logs.slint";

export { ProfileRow, GroupRow, NodeRow, AccountRow, ConnectionRow, OperationRow }

export enum TrayState { idle, connected, starting, stopping, restarting, error }

export component MainWindow inherits Window {
    title: "Mirage";
    icon: @image-url("../assets/icons/app.svg");
    in property <length> initial-window-width: 900px;
    in property <length> initial-window-height: 680px;
    in-out property <length> sidebar-width: 150px;
    out property <length> window-width: root.width;
    out property <length> window-height: root.height;
    callback geometry-changed();
    changed width => { if root.width >= 700px && root.height >= 460px { root.geometry-changed(); } }
    changed height => { if root.width >= 700px && root.height >= 460px { root.geometry-changed(); } }
    changed sidebar-width => { root.geometry-changed(); }
    preferred-width: root.initial-window-width;
    preferred-height: root.initial-window-height;
    min-width: 700px;
    min-height: 460px;
    background: root.surface-refresh ? Theme.surface : #FFFFFE;

    in property <string> version;
    in property <string> data-dir;
    in property <string> core-version;
    in property <string> status-text;
    in property <string> sidebar-status-text;
    in property <bool> running;
    in property <bool> failed;
    in property <bool> busy;
    in property <string> busy-text;
    in property <int> mixed-port;
    in-out property <bool> system-proxy-wanted;
    in property <bool> system-proxy-active;
    in-out property <bool> tun-wanted;
    in property <bool> tun-active;
    in property <bool> service-installed;
    in property <bool> service-busy;
    in property <string> connectivity-text;
    in property <int> connectivity-level;
    in property <int> routing-mode: -1;
    in property <string> exit-node;
    in property <string> profile-name;
    in property <string> account-plan;
    in property <string> account-usage;
    in property <[ProfileRow]> profiles;
    in property <[GroupRow]> groups;
    in property <string> testing-group;
    in property <[string]> policy-notes;
    in property <[string]> check-lines;
    in property <string> error-stage;
    in property <string> error-text;
    in property <bool> error-retry;
    in property <[AccountRow]> accounts;
    in property <string> revealed-account-id;
    in property <string> revealed-account-name;
    in property <bool> login-busy;
    in property <string> login-message;
    in property <bool> probing-hosts;
    in property <[string]> provider-hosts;
    in property <[string]> egress-options;
    in property <int> settings-port;
    in property <string> settings-bypass;
    in property <string> settings-user-agent;
    in property <int> settings-provider-egress;
    in property <bool> settings-auto-connect;
    in property <bool> settings-close-to-tray;
    in property <bool> settings-autostart;
    in property <bool> settings-tun-disable-system-proxy;
    in property <string> settings-connection-log-limit;
    in property <string> settings-operation-log-days;
    in property <string> core-path;
    in property <bool> geo-updating;
    in property <bool> exporting;
    // Traffic is fed only while the window is visible; connection logs continue in the tray (§17.4).
    in property <string> up-rate: "0 B/s";
    in property <string> down-rate: "0 B/s";
    in property <string> up-path;
    in property <string> down-path;
    in property <[ConnectionRow]> connection-logs;
    in property <[OperationRow]> operation-logs;
    in property <string> log-status;
    in property <int> log-total;
    in-out property <int> log-tab;
    in-out property <string> log-query;
    in-out property <int> log-filter;
    in-out property <bool> log-paused;
    function refresh-logs() {
        root.filter-logs(root.page == 4, root.log-tab == 1, root.log-query, root.log-filter, root.log-paused);
    }
    changed page => { root.refresh-logs(); }
    changed log-tab => { root.refresh-logs(); }
    changed log-query => { root.refresh-logs(); }
    changed log-filter => { root.refresh-logs(); }
    changed log-paused => { root.refresh-logs(); }
    in-out property <int> page: 0;
    in-out property <bool> sort-by-delay;
    // Kept here so leaving the nodes page does not reset search or tab.
    in-out property <string> node-filter;
    in-out property <int> node-group;

    private property <string> details-id;
    // ProfilesPage sits in an `if`, so the drawer cannot reach its LineEdit by id.
    private property <int> profile-drawer-dismissed-count: 0;
    private property <ProfileRow> delete-target;

    public function close-account-login() {
        account-dialog.close();
    }
    function confirm-delete(profile: ProfileRow) {
        root.delete-target = profile;
        delete-dialog.show();
    }

    // Toast: shown for a few seconds after `show-toast`.
    property <string> toast-text;
    property <bool> toast-visible;

    callback connect();
    callback disconnect();
    callback import-file();
    callback add-remote(string, string);
    callback update-profile(string);
    callback update-all();
    callback select-profile(string);
    callback remove-profile(string);
    callback copy-profile-url(string);
    callback set-update-policy(string, int, int);
    callback select-node(string, string);
    callback test-delay(string);
    callback sort-nodes(bool);
    callback set-system-proxy(bool);
    callback set-tun(bool);
    callback set-routing-mode(int);
    callback check-connectivity();
    callback dismiss-error();
    callback retry-error();
    callback provider-login(string, string, string);
    callback revalidate-account(string);
    callback reveal-account(string, bool);
    callback import-legacy(string);
    callback probe-hosts();
    callback save-settings(string, string, string, int, bool, bool, bool, bool, string, string);
    callback manage-service(bool);
    callback update-geodata();
    callback export-diagnostics();
    callback clear-connection-logs();
    callback filter-logs(bool, bool, string, int, bool);
    callback filter-nodes(string);

    public function show-toast(text: string) {
        root.toast-text = text;
        root.toast-visible = true;
        toast-timer.running = false;
        toast-timer.running = true;
    }

    toast-timer := Timer {
        interval: 3500ms;
        running: false;
        triggered => {
            root.toast-visible = false;
            self.running = false;
        }
    }

    // A full-surface color change invalidates cached damage after restoration.
    property <bool> surface-refresh;
    public function refresh-surface() {
        surface-timer.running = false;
        surface-timer.running = true;
    }
    surface-timer := Timer {
        interval: 16ms;
        running: false;
        triggered => {
            root.surface-refresh = !root.surface-refresh;
            self.running = false;
        }
    }

    HorizontalLayout {
        Sidebar {
            sidebar-width <=> root.sidebar-width;
            page <=> root.page;
            running: root.running;
            failed: root.failed;
            status-text: root.sidebar-status-text;
            up-rate: root.up-rate;
            down-rate: root.down-rate;
        }

        VerticalLayout {
            padding: 24px;
            min-width: 0px;
            min-height: 0px;
            spacing: 12px;

            if root.error-text != "": ErrorBar {
                stage: root.error-stage;
                text: root.error-text;
                can-retry: root.error-retry;
                retry => { root.retry-error(); }
                dismiss => { root.dismiss-error(); }
            }

            if root.page == 0: PageViewport {
                vertical-stretch: 1;
                OverviewPage {
                    status-text: root.status-text;
                    running: root.running;
                    failed: root.failed;
                    busy: root.busy;
                    profile-name: root.profile-name;
                    mixed-port: root.mixed-port;
                    core-version: root.core-version;
                    system-proxy-wanted <=> root.system-proxy-wanted;
                    system-proxy-active: root.system-proxy-active;
                    tun-wanted <=> root.tun-wanted;
                    tun-active: root.tun-active;
                    service-installed: root.service-installed;
                    set-tun(on) => { root.set-tun(on); }
                    connectivity-text: root.connectivity-text;
                    connectivity-level: root.connectivity-level;
                    routing-mode: root.routing-mode;
                    exit-node: root.exit-node;
                    up-rate: root.up-rate;
                    down-rate: root.down-rate;
                    up-path: root.up-path;
                    down-path: root.down-path;
                    plan: root.account-plan;
                    usage: root.account-usage;
                    connect => { root.connect(); }
                    disconnect => { root.disconnect(); }
                    set-system-proxy(on) => { root.set-system-proxy(on); }
                    check-connectivity => { root.check-connectivity(); }
                    set-routing-mode(m) => { root.set-routing-mode(m); }
                }
            }
            if root.page == 1: ProfilesPage {
                vertical-stretch: 1;
                profiles: root.profiles;
                busy: root.busy;
                drawer-dismissed-count: root.profile-drawer-dismissed-count;
                policy-notes: root.policy-notes;
                import-file => { root.import-file(); }
                add-remote(name, url) => { root.add-remote(name, url); }
                update(id) => { root.update-profile(id); }
                update-all => { root.update-all(); }
                select(id) => { root.select-profile(id); }
                remove(profile) => { root.confirm-delete(profile); }
                show-details(id) => {
                    root.reveal-account("", false);
                    root.details-id = id;
                    profile-drawer.show();
                }
                open-accounts => { account-dialog.show(); }
            }
            if root.page == 2: ProxiesPage {
                vertical-stretch: 1;
                groups: root.groups;
                running: root.running;
                testing-group: root.testing-group;
                sort-by-delay <=> root.sort-by-delay;
                filter <=> root.node-filter;
                current-group <=> root.node-group;
                select-node(g, n) => { root.select-node(g, n); }
                test-delay(g) => { root.test-delay(g); }
                sort-changed(on) => { root.sort-nodes(on); }
                filter-changed(text) => { root.filter-nodes(text); }
            }
            if root.page == 3: PageViewport {
                vertical-stretch: 1;
                SettingsPage {
                    saved-port: root.settings-port;
                    saved-bypass: root.settings-bypass;
                    saved-user-agent: root.settings-user-agent;
                    saved-provider-egress: root.settings-provider-egress;
                    saved-auto-connect: root.settings-auto-connect;
                    saved-close-to-tray: root.settings-close-to-tray;
                    saved-autostart: root.settings-autostart;
                    saved-tun-disable-system-proxy: root.settings-tun-disable-system-proxy;
                    saved-connection-log-limit: root.settings-connection-log-limit;
                    saved-operation-log-days: root.settings-operation-log-days;
                    service-installed: root.service-installed;
                    service-busy: root.service-busy;
                    tun-active: root.tun-active;
                    manage-service(install) => { root.manage-service(install); }
                    egress-options: root.egress-options;
                    core-version: root.core-version;
                    core-path: root.core-path;
                    running: root.running;
                    geo-updating: root.geo-updating;
                    busy: root.busy;
                    save(port, bypass, ua, egress, auto, tray, autostart, tun-no-proxy, connection-limit, operation-days) => { root.save-settings(port, bypass, ua, egress, auto, tray, autostart, tun-no-proxy, connection-limit, operation-days); }
                    update-geodata => { root.update-geodata(); }
                }
            }
            if root.page == 4: LogsPage {
                vertical-stretch: 1;
                running: root.running;
                exporting: root.exporting;
                status: root.log-status;
                total: root.log-total;
                connection-logs: root.connection-logs;
                operation-logs: root.operation-logs;
                tab <=> root.log-tab;
                query <=> root.log-query;
                filter <=> root.log-filter;
                paused <=> root.log-paused;
                export-diagnostics => { root.export-diagnostics(); }
                clear-connection-logs => { root.clear-connection-logs(); }
            }
        }
    }

    account-dialog := AccountDialog {
        width: root.width;
        height: root.height;
        login-busy: root.login-busy;
        busy: root.busy;
        login-message: root.login-message;
        has-account: root.accounts.length > 0;
        login(email, password) => { root.provider-login("ziyoumao", email, password); }
        import-legacy => { root.import-legacy("ziyoumao"); }
    }
    profile-drawer := Overlay {
        width: root.width;
        height: root.height;
        title: "配置设置";
        drawer: true;
        panel-width: 400px;
        dismissed => { root.profile-drawer-dismissed-count += 1; root.details-id = ""; root.reveal-account("", false); }
        // Put the scrollbar in the outer gutter; align content with the header.
        Rectangle {
            min-height: 0px;
            vertical-stretch: 1;
            PageScroll {
                width: parent.width + 16px;
                height: parent.height;
                content-padding: 0px;
                for p in root.profiles: VerticalLayout {
                    if p.id == root.details-id: ProfileDetails {
                        profile: p;
                        accounts: root.accounts;
                        revealed-account-id: root.revealed-account-id;
                        revealed-account-name: root.revealed-account-name;
                        egress-options: root.egress-options;
                        busy: root.busy || root.login-busy;
                        set-policy(id, hours, egress) => { root.set-update-policy(id, hours, egress); }
                        copy-url(id) => { root.copy-profile-url(id); }
                        refresh-account(id) => { root.revalidate-account(id); }
                        reveal-account(id, visible) => { root.reveal-account(id, visible); }
                    }
                }
            }
        }
    }
    delete-dialog := Overlay {
        width: root.width;
        height: root.height;
        title: "删除配置";
        init => { cancel-delete.focus(); }
        Text {
            text: "确定删除“" + root.delete-target.name + "”？";
            color: Theme.text;
            wrap: word-wrap;
        }
        Text {
            text: root.delete-target.account-id != ""
                ? "将同时清除本机保存的关联账号信息、登录会话、订阅地址和配置文件。后续需重新添加账号。"
                : "将删除该配置及本机保存的相关文件。";
            color: Theme.text-muted;
            wrap: word-wrap;
        }
        if root.delete-target.selected && root.running: Text {
            text: "该配置正在使用，删除后将断开当前连接。";
            color: Theme.danger;
            wrap: word-wrap;
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            cancel-delete := Button { text: "取消"; clicked => { delete-dialog.close(); } }
            Button {
                text: "确认删除";
                enabled: !root.busy && !root.login-busy;
                clicked => {
                    root.remove-profile(root.delete-target.id);
                    delete-dialog.close();
                }
            }
        }
    }

    if root.toast-visible || root.busy: Toast {
        text: root.toast-visible ? root.toast-text : root.busy-text;
        busy: !root.toast-visible && root.busy;
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 24px;
    }
}

export component AppTray inherits SystemTrayIcon {
    in property <TrayState> state: TrayState.idle;
    in property <image> state-icon: @image-url("../assets/icons/tray/idle.svg");
    in property <string> detail;
    in property <bool> window-visible: true;
    in property <bool> running;
    in property <bool> busy;
    in property <int> routing-mode: -1;
    in-out property <bool> system-proxy;
    in property <bool> tun-wanted;

    callback toggle-window();
    callback toggle-connection();
    callback set-system-proxy(bool);
    callback set-tun(bool);
    callback set-routing-mode(int);
    callback quit-app();

    icon: root.state-icon;
    tooltip: (state == TrayState.connected ? "Mirage - 已连接"
    : state == TrayState.error ? "Mirage - 错误"
    : state == TrayState.restarting ? "Mirage - 正在重启内核"
    : state == TrayState.starting ? "Mirage - 正在连接"
    : state == TrayState.stopping ? "Mirage - 正在断开"
    : "Mirage - 未连接") + (root.detail == "" ? "" : "\n" + root.detail);

    clicked => { root.toggle-window(); }

    Menu {
        MenuItem {
            title: root.window-visible ? "隐藏主窗口" : "显示主窗口";
            activated => { root.toggle-window(); }
        }
        MenuItem {
            title: root.busy ? "请稍候…" : root.running ? "断开" : "连接";
            enabled: !root.busy;
            activated => { root.toggle-connection(); }
        }
        MenuSeparator { }
        MenuItem {
            title: root.system-proxy ? "✓ 系统代理" : "系统代理";
            activated => { root.set-system-proxy(!root.system-proxy); }
        }
        MenuItem {
            title: root.tun-wanted ? "✓ TUN" : "TUN";
            enabled: !root.busy;
            activated => { root.set-tun(!root.tun-wanted); }
        }
        Menu {
            title: "路由模式";
            MenuItem {
                title: root.routing-mode == 0 ? "✓ 规则" : "规则";
                activated => { root.set-routing-mode(0); }
            }
            MenuItem {
                title: root.routing-mode == 1 ? "✓ 全局" : "全局";
                activated => { root.set-routing-mode(1); }
            }
            MenuItem {
                title: root.routing-mode == 2 ? "✓ 直连" : "直连";
                activated => { root.set-routing-mode(2); }
            }
        }
        MenuSeparator { }
        MenuItem {
            title: "退出";
            activated => { root.quit-app(); }
        }
    }
}
