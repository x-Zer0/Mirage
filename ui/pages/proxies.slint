import { Button, ListView, LineEdit, ScrollView } from "std-widgets.slint";
import { Theme } from "../components/theme.slint";

export struct NodeRow {
    name: string,
    delay: string,
    delay-level: int, // 0 unknown, 1 good, 2 slow, 3 timeout
    current: bool,
}

export struct GroupRow {
    name: string,
    kind: string,
    now: string,
    selectable: bool,
    nodes: [NodeRow],
}

export component ProxiesPage inherits VerticalLayout {
    in property <[GroupRow]> groups;
    in property <bool> running;
    in property <string> testing-group;
    in-out property <int> current-group: 0;
    in-out property <string> filter;
    callback select-node(string, string);
    callback test-delay(string);
    callback refresh();
    pure callback matches(string, string) -> bool;

    spacing: 12px;

    if !root.running: Text {
        text: "连接后显示代理组和节点。";
        color: Theme.text-muted;
    }

    if root.running && root.groups.length > 0: HorizontalLayout {
        spacing: 8px;
        ScrollView {
            height: 40px;
            horizontal-stretch: 1;
            HorizontalLayout {
                spacing: 6px;
                for g[i] in root.groups: Rectangle {
                    width: label.preferred-width + 24px;
                    height: 32px;
                    border-radius: 6px;
                    background: i == root.current-group ? Theme.nav-selected : tab.has-hover ? Theme.nav-hover : Theme.sidebar;
                    accessible-role: AccessibleRole.tab;
                    accessible-label: g.name;
                    tab := TouchArea { clicked => { root.current-group = i; } }
                    label := Text {
                        text: g.name;
                        color: i == root.current-group ? Theme.accent : Theme.text;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                    }
                }
            }
        }
        Button {
            text: "刷新";
            icon: @image-url("../../assets/icons/lucide/refresh-cw.svg");
            colorize-icon: true;
            clicked => { root.refresh(); }
        }
    }

    if root.running && root.groups.length > root.current-group: VerticalLayout {
        spacing: 8px;
        vertical-stretch: 1;
        property <GroupRow> group: root.groups[root.current-group];

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: group.kind + " · 当前：" + group.now + (group.selectable ? "" : "（自动选择，只读）");
                color: Theme.text-muted;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            LineEdit { placeholder-text: "搜索节点"; width: 180px; text <=> root.filter; }
            Button {
                text: root.testing-group == group.name ? "测速中…" : "测速";
                icon: @image-url("../../assets/icons/lucide/activity.svg");
                colorize-icon: true;
                enabled: root.testing-group == "";
                clicked => { root.test-delay(group.name); }
            }
        }

        ListView {
            vertical-stretch: 1;
            for n in group.nodes: Rectangle {
                visible: root.matches(n.name, root.filter);
                height: self.visible ? 40px : 0px;
                border-radius: 6px;
                background: n.current ? Theme.nav-selected : row.has-hover && group.selectable ? Theme.nav-hover : transparent;
                accessible-role: list-item;
                accessible-label: n.name;
                accessible-item-selected: n.current;
                accessible-action-default => { if (group.selectable) { root.select-node(group.name, n.name); } }
                row := TouchArea {
                    enabled: group.selectable;
                    mouse-cursor: group.selectable ? pointer : default;
                    clicked => { root.select-node(group.name, n.name); }
                }
                HorizontalLayout {
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 8px;
                    Text {
                        text: n.name;
                        color: n.current ? Theme.accent : Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: n.delay;
                        vertical-alignment: center;
                        color: n.delay-level == 1 ? Theme.ok : n.delay-level == 2 ? Theme.warn : n.delay-level == 3 ? Theme.danger : Theme.text-muted;
                    }
                }
            }
        }
    }
}
